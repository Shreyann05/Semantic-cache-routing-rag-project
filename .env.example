LLM_PROVIDER=groq
GROQ_API_KEY=
SMALL_MODEL=groq/openai/gpt-oss-20b
LARGE_MODEL=groq/openai/gpt-oss-120b
SEMANTIC_CACHE_THRESHOLD=0.60
CACHE_TTL_SECONDS=86400
CORPUS_VERSION=demo-v1
DATA_DIR=data/runtime
# Configure only verified Groq rates in USD per 1M tokens; zero disables estimates.
SMALL_MODEL_INPUT_USD_PER_M=0
SMALL_MODEL_OUTPUT_USD_PER_M=0
LARGE_MODEL_INPUT_USD_PER_M=0
LARGE_MODEL_OUTPUT_USD_PER_M=0
